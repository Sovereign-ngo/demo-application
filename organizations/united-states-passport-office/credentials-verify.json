{
  "organizationId": "united_states_passport_office",
  "verificationMethod": {
    "proofFormats": ["vc+jwt"],
    "algorithms": ["EdDSA"],
    "resolveIssuerDid": true,
    "verifySignature": true,
    "matchCredentialSubjectToAuthenticatedWebId": true,
    "checkValidityPeriod": true,
    "checkCredentialStatusWhenPresent": true,
    "rejectUnknownCriticalClaims": true
  },
  "credentials": {
    "DriversLicenseCredential": {
      "acceptedIssuers": ["did:web:driver-license.api.demo.sovereign.ngo"],
      "requiredClaims": ["name", "dob", "licenseNumber", "jurisdiction"]
    }
  }
}
