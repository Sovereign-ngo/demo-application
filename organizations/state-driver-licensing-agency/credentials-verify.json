{
  "organizationId": "state_driver_licensing_agency",
  "verificationMethod": {
    "proofFormats": ["vc+jwt"],
    "algorithms": ["EdDSA"],
    "resolveIssuerDid": true,
    "verifySignature": true,
    "matchCredentialSubjectToAuthenticatedWebId": true,
    "checkValidityPeriod": true,
    "checkCredentialStatusWhenPresent": true,
    "rejectUnknownCriticalClaims": true
  },
  "credentials": {
    "PassportCredential": {
      "acceptedIssuers": ["did:web:passport.api.demo.sovereign.ngo"],
      "requiredClaims": ["name", "dob", "passportNumber", "issuingCountry"]
    }
  }
}
