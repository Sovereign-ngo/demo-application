{
  "organizationId": "nolichucky_family_clinic",
  "verificationMethod": {
    "proofFormats": ["vc+jwt"],
    "algorithms": ["EdDSA"],
    "resolveIssuerDid": true,
    "verifySignature": true,
    "matchCredentialSubjectToAuthenticatedWebId": true,
    "checkValidityPeriod": true,
    "checkCredentialStatusWhenPresent": true,
    "rejectUnknownCriticalClaims": true
  },
  "credentials": {
    "DriversLicenseCredential": {
      "acceptedIssuers": ["did:web:demo.sovereign.ngo:verifier:drivers-license"],
      "requiredClaims": ["name", "dob", "licenseNumber", "state"]
    },
    "InsuranceCoverageCredential": {
      "acceptedIssuers": ["did:web:demo.sovereign.ngo:insurer"],
      "requiredClaims": ["memberId", "coverageStatus"]
    },
    "ImagingResultCredential": {
      "acceptedIssuerRelationship": "referral-destination",
      "requiredClaims": ["subject", "performedAt", "resultSummary"]
    }
  }
}
