{
  // Production deployment for demo.sovereign.ngo.
  "name": "sovereign-demo-site",
  "main": "./website-worker.js",
  "compatibility_date": "2026-09-12",
  "vars": {
    "DEPLOYMENT_ENVIRONMENT": "production",
    "APP_URL": "https://app.demo.sovereign.ngo/"
  },
  "routes": [
    {
      "pattern": "demo.sovereign.ngo",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "../website",
    "binding": "ASSETS",
    "run_worker_first": ["/config.js"],
    "not_found_handling": "404-page"
  }
}
