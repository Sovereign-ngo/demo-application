{
  "name": "sovereign-organizations",
  "main": "./organization-worker.js",
  "compatibility_date": "2026-09-12",
  "observability": { "enabled": true },
  "vars": {
    "DEPLOYMENT_ENVIRONMENT": "production",
    "WEBSITE_URL": "https://demo.sovereign.ngo/",
    "APP_URL": "https://demo.sovereign.ngo/",
    "PODS_URL": "https://pods.demo.sovereign.ngo/"
  },
  "workers_dev": false,
  "routes": [
    {
      "pattern": "*.api.demo.sovereign.ngo/*",
      "zone_name": "sovereign.ngo"
    }
  ],
  "assets": {
    "directory": "./organization-assets",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
